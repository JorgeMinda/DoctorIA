# NOTE: Wasp requires a running PostgreSQL. Configure your DATABASE_URL below.
# Example: DATABASE_URL=postgresql://user:password@localhost:5432/doctoria
DATABASE_URL=

# Set this as a comma-separated list of emails you want to give admin privileges to upon registration.
ADMIN_EMAILS=admin@doctoria.com

# Get your sendgrid api key at https://app.sendgrid.com/settings/api_keys.
SENDGRID_API_KEY=test...

# Clave de API de OpenRouter (modelo DeepSeek gratis) para la estructuración de IA (PD-01)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Credenciales de API ICD-11 de la OMS (opcionales en dev, requeridas para búsqueda CIE-11 en prod)
# Obtener en https://icd.who.int/icdapi
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
