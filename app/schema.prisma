// schema.prisma - DoctorIA (MVP 001-doctoria-mvp)
// Fuente: specs/001-doctoria-mvp/data-model.md
// Datos clínicos EXCLUSIVAMENTE sintéticos (Constitution P5). Cero PII real.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ────────────────────────────── IDENTIDAD (Wasp Auth) ──────────────────────────────
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email    String?  @unique
  username String?  @unique
  isAdmin  Boolean  @default(false)

  // DoctorIA: habilitación explícita de profesional médico (research R-02).
  // `isAdmin=true` + `isMedico=true` es INVÁLIDO — bloqueado por guards.
  isMedico Boolean  @default(false)

  // Secretaria clínica: gestiona pacientes/citas/signos vitales; SIN acceso
  // al contenido de notas clínicas (R1). Mutuamente excluyente con los otros
  // roles — bloqueado por guards.
  isSecretaria Boolean @default(false)

  // Rol paciente: acceso a su propio historial clínico confirmado y próximas citas.
  // Mutuamente excluyente con los otros roles — bloqueado por guards.
  isPaciente Boolean @default(false)

  // Soft delete (R4): usuarios con historial nunca se borran físicamente;
  // se desactivan. Autentican, pero los guards clínicos los rechazan (R2).
  isActive Boolean @default(true)

  fullName String?
  specialty String?

  // Campos payment/SaaS de Open SaaS: NO forman parte del dominio clínico (data-model.md §1).
  paymentProcessorUserId         String?   @unique
  lemonSqueezyCustomerPortalUrl  String?
  subscriptionStatus             String?
  subscriptionPlan               String?
  datePaid                       DateTime?
  credits                        Int       @default(3)

  // Relaciones DoctorIA (data-model.md §1)
  patientProfile       SyntheticPatient?
  authoredNotes        ClinicalNote[] @relation("NoteAuthor")
  confirmedNotes       ClinicalNote[] @relation("NoteConfirmer")
  authoredEpicrises    Epicrisis[]    @relation("EpicrisisAuthor")
  confirmedEpicrises   Epicrisis[]    @relation("EpicrisisConfirmer")
  auditLogs            AuditLog[]
  authorizedPatients   MedicoPatientAccess[] @relation("MedicoAccess")
  grantedAccesses      MedicoPatientAccess[] @relation("AccessGranter")
  citasAsMedico        Cita[]         @relation("MedicoCitas")
  scheduledCitas       Cita[]         @relation("CitaSecretary")
  recordedVitalSigns   VitalSign[]    @relation("VitalSignRecorder")
  recordedPreClinicalRecords PreClinicalRecord[] @relation("PreClinicalRecorder")
  patientLinkRequests  PatientLinkRequest[] @relation("UserLinkRequests")
  reviewedLinkRequests PatientLinkRequest[] @relation("RequestReviewer")
}

enum DocumentType {
  CEDULA
  PASAPORTE
  OTRO
}

enum LinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ─────────────── PACIENTES SINTÉTICOS / PRODUCCIÓN REAL (P5) ───────────────
model SyntheticPatient {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Vínculo opcional con la cuenta de usuario del paciente autenticado
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id])

  syntheticId String  @unique // formato "PAC-NNN", ej. "PAC-001" (identificador técnico legacy)
  firstName   String
  lastName    String
  birthDate   DateTime
  sex         String          // "M", "F", "O"

  // Identificación real de producción
  tipoDocumento   DocumentType  @default(CEDULA)
  documento       String?       @db.VarChar(30) // documento normalizado
  documentHash    String?       @unique         // HMAC-SHA256 para búsqueda sin exponer PII
  paisEmisor      String?       @default("EC")

  medicalHistory String?
  allergies      String?

  // Perfil demográfico / contacto
  nationality     String?
  heightCm        Int?     // talla (cm)
  weightKg        Int?     // peso (kg)
  ethnicity       String?
  bloodType       String?  // A+, A-, B+, B-, AB+, AB-, O+, O-
  address         String?
  phone           String?
  emergencyName   String?   // nombre del contacto de emergencia
  emergencyPhone  String?
  insurance       String?  // tipo de seguro / entidad

  // Soft delete (R4): con historial clínico/citas el paciente se desactiva
  // (isActive=false) en lugar de eliminarse físicamente.
  isActive Boolean @default(true)

  clinicalNotes      ClinicalNote[]
  epicrises          Epicrisis[]
  authorizedMedicos  MedicoPatientAccess[]
  citas              Cita[]
  auditLogs          AuditLog[]
  vitalSigns         VitalSign[]
  preClinicalRecords PreClinicalRecord[]
  linkRequests       PatientLinkRequest[]

  @@index([syntheticId])
  @@index([lastName, firstName])
  @@index([documentHash])
}

// ─────────────── SOLICITUDES DE VINCULACIÓN DE PACIENTE (Fase Producción) ───────────────
model PatientLinkRequest {
  id              String            @id @default(uuid())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  userId          String
  user            User              @relation("UserLinkRequests", fields: [userId], references: [id], onDelete: Cascade)
  patientId       String
  patient         SyntheticPatient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  status          LinkRequestStatus @default(PENDING)
  documentType    DocumentType      @default(CEDULA)
  paisEmisor      String?           @default("EC")

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?             @relation("RequestReviewer", fields: [reviewedById], references: [id])
  rejectionReason String?
  expiresAt       DateTime

  @@index([status])
  @@index([userId])
  @@index([patientId])
}

// ─────────────── AUTORIZACIÓN EXPLÍCITA MÉDICO ↔ PACIENTE (R-10) ───────────────
model MedicoPatientAccess {
  id        String   @id @default(uuid())
  grantedAt DateTime @default(now())

  medicoId    String
  medico      User     @relation("MedicoAccess", fields: [medicoId], references: [id])
  patientId   String
  patient     SyntheticPatient @relation(fields: [patientId], references: [id])
  grantedById String
  grantedBy   User     @relation("AccessGranter", fields: [grantedById], references: [id])

  @@unique([medicoId, patientId])
  @@index([patientId])
}

// ─────────────── AGENDA / CITAS (Semana 5 - historial y disponibilidad del médico) ───────────────

enum CitaStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  // Cita vencida que nunca se inició (transición explícita; la agenda la
  // muestra como estado derivado para citas SCHEDULED en el pasado).
  NOT_STARTED
}

model Cita {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicoId  String
  medico    User             @relation("MedicoCitas", fields: [medicoId], references: [id])
  patientId String
  patient   SyntheticPatient @relation(fields: [patientId], references: [id])

  scheduledAt     DateTime // comienzo de la cita (UTC)
  durationMinutes Int      @default(30)

  status CitaStatus @default(SCHEDULED)

  // Trazabilidad: quién agendó/creó la cita (secretaria o admin).
  secretaryId String?
  secretary   User?    @relation("CitaSecretary", fields: [secretaryId], references: [id])

  reason String? // motivo de la cita (no clínico estructurado)

  auditLogs AuditLog[]
  vitalSigns VitalSign[]
  preClinicalRecord PreClinicalRecord? @relation("CitaPreClinicalRecord")

  @@index([medicoId, scheduledAt])
  @@index([patientId, scheduledAt])
}

// ─────────────── SIGNOS VITALES (toma por Secretaria/Médico, sin contenido narrativo) ───────────────
model VitalSign {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  patientId String
  patient   SyntheticPatient @relation(fields: [patientId], references: [id])

  citaId String?
  cita   Cita?   @relation(fields: [citaId], references: [id])

  recordedById String
  recordedBy   User     @relation("VitalSignRecorder", fields: [recordedById], references: [id])

  // Valores validados contra rangos plausibles en la action/service.
  systolicBP       Int // mmHg
  diastolicBP      Int // mmHg
  heartRate        Int // lpm
  temperature      Float // °C
  respiratoryRate  Int // rpm
  oxygenSaturation Int // %
  weight           Float // kg
  height           Float // cm

  @@index([patientId, createdAt])
}

// ─────────────── REGISTRO PRE-CLÍNICO (Secretaria, ligado 1:1 a Cita) ─�──────────────
// Dato administrativo previo a la atención médica. ESTRICTAMENTE desacoplado de la
// Historia Clínica: NO contiene notas narrativas ni diagnósticos. Accesible por
// secretaria, médico y admin; NUNCA expone contenido de ClinicalNote/Epicrisis.
model PreClinicalRecord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relación 1:1 con la cita (una secretaria registra un solo pre-clínico por cita).
  citaId    String   @unique
  cita      Cita     @relation("CitaPreClinicalRecord", fields: [citaId], references: [id])

  patientId String
  patient   SyntheticPatient @relation(fields: [patientId], references: [id])

  recordedById String
  recordedBy   User   @relation("PreClinicalRecorder", fields: [recordedById], references: [id])

  // Motivo de consulta (registrado por secretaria, no clínico estructurado).
  motivoConsulta String

  // Signos vitales (validados contra rangos plausibles en la action/service).
  systolicBP       Int
  diastolicBP      Int
  heartRate        Int
  temperature      Float
  respiratoryRate  Int
  oxygenSaturation Int
  weight           Float
  height           Float

  @@index([patientId, createdAt])
  @@index([recordedById])
}

// ─────────────── NOTA CLÍNICA (estados + adendas, RF-005..RF-029) ───────────────
model ClinicalNote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   SyntheticPatient @relation(fields: [patientId], references: [id])

  authorId String
  author   User   @relation("NoteAuthor", fields: [authorId], references: [id])

  confirmedById String?
  confirmedBy   User?  @relation("NoteConfirmer", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  originalText String // RNF-004: SIEMPRE preservado, nunca modificado

  // 5 secciones obligatorias (RF-007)
  motivoConsulta     String?
  notaClinica        String?
  examenFisico       String?
  valoracionClinica  String?
  planIndicaciones   String?
  sectionsNotApplicable Json? // { seccion: "justificación" }

  aiAssisted         Boolean @default(false)
  aiRawResponse      String? // solo auditoría/debug, NO clínico
  unclassifiedContent String? // "Requiere revisión"

  status   String @default("DRAFT_MANUAL") // DRAFT_MANUAL | DRAFT_AI_ASSISTED | REVIEWED | CONFIRMED
  noteType String @default("ORIGINAL")     // ORIGINAL | ADDENDUM

  // Adendas (RF-029, R-04): self-relation de versiones
  parentNoteId String?
  parentNote   ClinicalNote? @relation("NoteVersions", fields: [parentNoteId], references: [id])
  childNotes   ClinicalNote[] @relation("NoteVersions")
  addendumReason String?

  // Clasificación CIE-11 (metadata, NO contenido clínico).
  // El médico asigna manualmente ANTES de confirmar (inmutabilidad post-confirmación).
  cie11Code        String?
  cie11Description String?
  cie11Uri         String?

  auditLogs AuditLog[]

  @@index([patientId, createdAt])
  @@index([authorId])
  @@index([status])
  @@index([parentNoteId])
}

// ─────────────── EPICRISIS (10 elementos, RF-018, misma inmutabilidad) ───────────────
model Epicrisis {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   SyntheticPatient @relation(fields: [patientId], references: [id])

  authorId String
  author   User   @relation("EpicrisisAuthor", fields: [authorId], references: [id])

  confirmedById String?
  confirmedBy   User?  @relation("EpicrisisConfirmer", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  // Elementos mínimos (RF-018)
  patientIdentification  String
  reasonForAdmission     String?
  relevantHistory        String?
  evolutionSummary       String?
  proceduresResults      String?
  validatedDiagnoses     String?
  conditionAtDischarge   String?
  followUpInstructions   String?
  responsibleProfessional String
  dateTime               DateTime

  aiAssisted Boolean @default(true)
  status   String @default("DRAFT_AI_ASSISTED") // DRAFT_AI_ASSISTED | REVIEWED | CONFIRMED
  noteType String @default("ORIGINAL")          // ORIGINAL | ADDENDUM

  parentEpicrisisId String?
  parentEpicrisis   Epicrisis? @relation("EpicrisisVersions", fields: [parentEpicrisisId], references: [id])
  childEpicrises    Epicrisis[] @relation("EpicrisisVersions")
  addendumReason    String?

  // Clasificación CIE-11 (metadata, NO contenido clínico).
  // El médico asigna manualmente ANTES de confirmar (inmutabilidad post-confirmación).
  cie11Code        String?
  cie11Description String?
  cie11Uri         String?

  auditLogs AuditLog[]

  @@index([patientId, createdAt])
}

// ─────────────── AUDITORÍA (RF-019, RF-020, RNF-007 — cero contenido clínico) ───────────────
model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  action       String // ver lista de Audit Actions en data-model.md §2
  resourceType String // PATIENT | NOTE | EPICRISIS | CITA | USER | SYSTEM
  resourceId   String?
  metadata     Json?  // solo metadata no clínica (transiciones de estado, accessAction)

  patientId      String?
  patient        SyntheticPatient? @relation(fields: [patientId], references: [id])
  clinicalNoteId String?
  clinicalNote   ClinicalNote? @relation(fields: [clinicalNoteId], references: [id])
  epicrisisId    String?
  epicrisis      Epicrisis? @relation(fields: [epicrisisId], references: [id])
  citaId         String?
  cita           Cita? @relation(fields: [citaId], references: [id])

  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
}
